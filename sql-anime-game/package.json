{
  "name": "sakura-query",
  "productName": "Sakura Query",
  "version": "0.1.0",
  "description": "Jogo anime para aprender SQL de verdade / Anime game to learn real SQL",
  "main": "main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "node tools/build-data.js && electron .",
    "dist:win": "node tools/build-data.js && electron-builder --win",
    "dist:linux": "node tools/build-data.js && electron-builder --linux",
    "dist:mac": "node tools/build-data.js && electron-builder --mac",
    "test": "node tools/build-data.js && node tests/validate-content.js && node tests/validate-dataia.js",
    "build:data": "node tools/build-data.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "sql.js": "1.10.3"
  },
  "build": {
    "appId": "com.sakuraquery.game",
    "productName": "Sakura Query",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": "dir"
    },
    "linux": {
      "target": "dir"
    },
    "mac": {
      "target": "dir"
    }
  }
}
